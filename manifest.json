{
  "manifest_version": 3,
  "name": "智能书签管理器",
  "version": "1.1.0",
  "description": "帮助您整理和发现收藏的网页",
  "permissions": ["bookmarks", "storage", "activeTab", "scripting"],
  "action": {
    "default_title": "打开智能书签抽屉",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
